{
  "name": "portapulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run compile:contract && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "node --test worker/alert-rules.test.mjs src/lib/endpoints.test.js src/lib/evm-wallet.test.js src/lib/wallet-connection.test.js",
    "worker": "node worker/heartbeat.mjs",
    "verify": "node scripts/verify-client.mjs",
    "compile:contract": "node scripts/compile-contract.mjs"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "solc": "0.8.30",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
